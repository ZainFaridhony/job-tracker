# Supabase project: Job Tracker (rruexatjgmmazyldqirp, ap-southeast-1)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<from Supabase dashboard: Settings > API keys>
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001

# Google sign-in renders only when this is set. The client id and secret live in
# the Supabase dashboard (Auth > Providers > Google), never here.
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=1

# Groq, for CV profile extraction. Server-only — never NEXT_PUBLIC_.
GROQ_API_KEY=gsk_<from https://console.groq.com/keys>
